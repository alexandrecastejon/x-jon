# Desenvolvimento: opcional (SQLite por padrão)
# DJANGO_SECRET_KEY=uma-chave-segura

# Produção (exemplo)
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=meuapp.onrender.com
# POSTGRES_DB=xjon
# POSTGRES_USER=xjon
# POSTGRES_PASSWORD=
# POSTGRES_HOST=
# POSTGRES_PORT=5432
# CORS_ALLOWED_ORIGINS=https://main.di9p4hmrarknh.amplifyapp.com
# (origem exata do front em produção; vírgula se várias URLs)

# Avatares em S3 (opcional; se definires AWS_STORAGE_BUCKET_NAME, o default storage passa a S3)
# AWS_STORAGE_BUCKET_NAME=x-jon-media-prod
# AWS_S3_REGION_NAME=eu-west-1
# Em EC2/App Runner/ECS com IAM role, podes omitir chaves; caso contrário:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Opcional: domínio CloudFront ou bucket customizado
# AWS_S3_CUSTOM_DOMAIN=media.exemplo.com
